# DEEC Studio — cache strategy for Hostinger / Apache / LiteSpeed
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hours"
  ExpiresByType application/javascript "access plus 1 hours"
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # css/js get stale-while-revalidate/stale-if-error on top of
  # no-cache/must-revalidate: if a revalidation request gets cut short
  # (seen on iOS Safari after rapid reloads — it can cancel in-flight
  # requests), the browser is explicitly allowed to fall back to the
  # last good cached copy instead of ending up with no stylesheet at
  # all, which is what was producing the unstyled-HTML flash.
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate, stale-while-revalidate=86400, stale-if-error=86400"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/javascript .js
  AddType application/javascript .mjs
  AddType text/css .css
</IfModule>

# Security headers — scoped to the resources this site actually loads
# (self + Fontshare + Google Fonts + Whop's tracking pixel + Meta Pixel).
# There's no Whop checkout iframe anymore — every CTA opens WhatsApp
# instead (see main.js's initWhatsapp()) — so frame-src/payment no
# longer list whop.com; connect-src keeps it since the tracking script
# may still call back to it directly.
#
# script-src no longer needs any 'sha256-...' inline-script hashes: the
# Whop + Meta Pixel base snippets used to sit inline in <head>
# (allowlisted by hash instead of 'unsafe-inline', so every OTHER
# inline script stayed blocked) but now live as loadAnalyticsTracking()
# in main.js, gated behind the cookie consent modal (see
# initCookieConsent()) — main.js is already trusted via 'self', so it
# needs no hash, and there's no inline script left anywhere in the
# project to allowlist. https://t.whop.tw is Whop's tracking domain
# (loads s.js, sends events) — unrelated to the WhatsApp CTAs, kept for
# Whop's own analytics. https://connect.facebook.net/https://www.facebook.com
# are Meta's (loads fbevents.js, sends events, serves the <noscript>
# fallback pixel image).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://t.whop.tw https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com; frame-src https://www.facebook.com; connect-src 'self' https://whop.com https://t.whop.tw https://www.facebook.com https://connect.facebook.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'"
  # Forces HTTPS for a year on every future visit, including subdomains.
  # Browsers ignore this header entirely when it arrives over plain HTTP
  # (per spec), so it's safe to send unconditionally here rather than
  # gating it on mod_rewrite's HTTPS var. No "; preload" — that submits
  # the domain to browsers' hardcoded preload list, far harder to
  # reverse than this header alone.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # checkout.html only — everything above still applies to it (this
  # FilesMatch runs after the site-wide block, in the same <IfModule>, so
  # its "Header set" calls replace the two headers below for THIS file
  # only; every other file keeps the plain policy above unchanged).
  # Whop's checkout-embed script (cdn.whop.com/elements/amber/elements.js,
  # loaded lazily by lib/checkout.js — see docs.whop.com/developer/guides/
  # embed-checkout) needs script-src/connect-src for cdn.whop.com, and its
  # iframe needs frame-src for whop.com plus a Permissions-Policy carve-out
  # for the Payment Request API (Apple/Google Pay inside that iframe).
  # ⚠️ https://checkout.whop.com is added defensively for the iframe's
  # likely origin but was NOT confirmed against Whop's docs the way
  # cdn.whop.com was — if the browser console shows a CSP violation for a
  # different whop.com subdomain once this is actually tested, add that
  # exact origin here instead/also.
  # Kept byte-for-byte consistent with _headers' checkout CSP, including
  # worker-src 'self' blob: (Whop Elements' internal Web Worker) and the
  # Apple Pay SDK origin (applepay.cdn-apple.com) — see _headers' own
  # comments for why each entry is there.
  <FilesMatch "^checkout\.html$">
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self \"https://whop.com\" \"https://cdn.whop.com\")"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://t.whop.tw https://connect.facebook.net https://cdn.whop.com https://whop.com https://*.whop.com https://applepay.cdn-apple.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://whop.com; frame-src https://www.facebook.com https://whop.com https://checkout.whop.com https://cdn.whop.com https://*.whop.com https://applepay.cdn-apple.com; connect-src 'self' https://whop.com https://t.whop.tw https://www.facebook.com https://connect.facebook.net https://cdn.whop.com https://checkout.whop.com https://*.whop.com https://applepay.cdn-apple.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com https://whop.com; object-src 'none'"
  </FilesMatch>
</IfModule>
