# Cloudflare Workers/Pages static-assets headers.
# .htaccess only applies on Apache/LiteSpeed (Hostinger) — this file is the
# equivalent for the Cloudflare deployment (catering-tools-by-deecstudio).
#
# Strict-Transport-Security forces HTTPS for a full year on every future
# visit, including subdomains — closes the small window where a visitor
# typing the bare domain (no https://) could have their very first request
# go out over plain HTTP before Cloudflare's redirect kicks in. No
# "; preload" — that submits the domain to browsers' hardcoded preload
# list, which is far harder to reverse than this header alone.
#
# script-src no longer needs any 'sha256-...' inline-script hashes: the
# Whop + Meta Pixel base snippets used to sit inline in <head> (allowlisted
# by hash instead of 'unsafe-inline', so every OTHER inline script stayed
# blocked) but now live as loadAnalyticsTracking() in main.js, gated behind
# the cookie consent modal (see initCookieConsent()) — main.js is already
# trusted via 'self', so it needs no hash, and there's no inline script
# left anywhere in the project to allowlist. https://t.whop.tw is Whop's
# tracking domain (loads s.js, sends events) — unrelated to the WhatsApp
# CTAs, kept for Whop's own analytics.
# https://connect.facebook.net/https://www.facebook.com are Meta's (loads
# fbevents.js, sends events, serves the <noscript> fallback pixel image).
# facebook.com is also in form-action: fbevents.js falls back to a hidden
# iframe/form POST to deliver events when its primary fetch/image beacon
# is blocked (privacy modes, some browsers) — confirmed by testing, not
# guessed. frame-src/payment no longer list whop.com — that was only for
# the embedded Whop checkout iframe (Apple/Google Pay inside it), removed
# when every CTA switched to opening WhatsApp instead; connect-src keeps
# whop.com since the tracking script may still call back to it directly.
# Some other random-looking third-party domains (AWS/GCP hostnames)
# showed up as blocked connect-src attempts during testing — NOT
# allowlisted here on purpose, they don't look like standard Meta
# infrastructure and weren't verified as legitimate.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://t.whop.tw https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com; frame-src https://www.facebook.com; connect-src 'self' https://whop.com https://t.whop.tw https://www.facebook.com https://connect.facebook.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/*.html
  Cache-Control: no-cache, must-revalidate

# stale-while-revalidate/stale-if-error on top of no-cache/must-revalidate:
# if a revalidation request gets cut short (seen on iOS Safari after 2-3
# rapid reloads — it can cancel in-flight requests instead of retrying),
# the browser is explicitly allowed to fall back to the last good cached
# copy instead of ending up with no stylesheet/script at all, which is
# what was producing an unstyled-HTML flash on repeated fast refreshes.
/*.css
  Cache-Control: no-cache, must-revalidate, stale-while-revalidate=86400, stale-if-error=86400

/*.js
  Cache-Control: no-cache, must-revalidate, stale-while-revalidate=86400, stale-if-error=86400

/assets/*
  Cache-Control: public, max-age=2592000

# Vendored PDF library (lib/vendor/) — pinned to one version, never edited
# in place; a version bump ships under a new path instead of overwriting
# this one, so it's safe to cache hard rather than revalidate like the
# site's own /*.js (this rule is more specific than /*.js above, so it
# wins for these two files).
/lib/vendor/*
  Cache-Control: public, max-age=2592000, immutable

# checkout.html only — everything from the /* block above still applies
# EXCEPT Permissions-Policy/Content-Security-Policy, which this block
# explicitly deletes (via "! Header-Name", see below) before setting its
# own values — every other page keeps the plain policy above unchanged.
# Whop's checkout-embed script (cdn.whop.com/elements/amber/elements.js,
# loaded lazily by lib/checkout.js — see docs.whop.com/developer/guides/
# embed-checkout) needs script-src/connect-src for cdn.whop.com, and its
# iframe needs frame-src for whop.com plus a Permissions-Policy carve-out
# for the Payment Request API (Apple/Google Pay inside that iframe).
# ⚠️ https://checkout.whop.com is added defensively for the iframe's
# likely origin but was NOT confirmed against Whop's docs the way
# cdn.whop.com was — if the browser console shows a CSP violation for a
# different whop.com subdomain once this is actually tested, add that
# exact origin here instead/also.
# worker-src 'self' blob: — Whop Elements spins up a Web Worker from a
# blob: URL internally (confirmed via a live CSP violation during E2E
# testing: "Creating a worker from 'blob:...' violates ... script-src",
# since with no worker-src directive the browser falls back to
# script-src, and 'self' does not cover blob: URLs). Scoped to this path
# only, same as everything else in this block.
#
# BOTH of the two path patterns below are needed for the SAME policy:
# Cloudflare Pages serves this file at the clean URL /checkout (the
# footer link points at checkout.html, but Pages 301s that to the
# extension-less URL and _headers rules match the FINAL served path) —
# confirmed live: a real browser hitting /checkout got the site-wide
# default CSP instead of this override, which is what blocked
# cdn.whop.com in the first place. /checkout.html is kept too in case
# anything ever links straight to the .html path pre-redirect.
#
# The "! Header-Name" line before each real header is load-bearing, not
# decoration: Cloudflare Pages does NOT have the general /* block's
# Content-Security-Policy/Permissions-Policy get replaced by this more
# specific block's values — confirmed live, it sends BOTH as separate
# header lines on the same response, and the browser enforces their
# INTERSECTION. Without the "!" removal, the /* block's CSP (no
# cdn.whop.com) stayed active alongside this one and kept blocking the
# Whop script even after cdn.whop.com was added here. "!" deletes the
# inherited header for this path before the line below sets the real one.
/checkout.html
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://whop.com")
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://t.whop.tw https://connect.facebook.net https://cdn.whop.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://whop.com; frame-src https://www.facebook.com https://whop.com https://checkout.whop.com; connect-src 'self' https://whop.com https://t.whop.tw https://www.facebook.com https://connect.facebook.net https://cdn.whop.com https://checkout.whop.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com https://whop.com; object-src 'none'

/checkout
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://whop.com")
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://t.whop.tw https://connect.facebook.net https://cdn.whop.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://api.fontshare.com https://cdn.fontshare.com https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://whop.com; frame-src https://www.facebook.com https://whop.com https://checkout.whop.com; connect-src 'self' https://whop.com https://t.whop.tw https://www.facebook.com https://connect.facebook.net https://cdn.whop.com https://checkout.whop.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://www.facebook.com https://whop.com; object-src 'none'
