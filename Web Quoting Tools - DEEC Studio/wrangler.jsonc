{
  "name": "deec-studio-web-quoting-tools",
  "compatibility_date": "2026-09-21",
  "main": "dist_worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "WHOP_PURCHASES", "id": "ab4f4e764ea24b91979a9e223c1f4e5f" }
  ],
  // Official legal-document PDFs — one file per <document>-<version>-<lang>
  // (see generate-legal-pdfs.js). Same file served to: the legal page's
  // download button, and the post-payment confirmation email. Never
  // written to from the public site — only via the ADMIN_UPLOAD_SECRET-
  // gated functions/api/admin/upload-legal-pdf.js, run by hand whenever a
  // new version is generated.
  "r2_buckets": [
    { "binding": "LEGAL_DOCS", "bucket_name": "deec-studio-legal-documents" }
  ],
  // Checkout acceptance ledger (see schema.sql). database_id below is a
  // placeholder — run `wrangler d1 create deec-studio-quoting-tools-checkout`
  // and paste the real id it prints. See schema.sql's header for the full
  // one-time setup.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deec-studio-quoting-tools-checkout",
      "database_id": "03f674db-f227-442f-81b8-b6e12636f0d0"
    }
  ],
  "vars": {
    "META_DATASET_ID": "1068830012634174",
    // "From" address for the post-payment confirmation email (see
    // functions/api/webhooks/whop.js). Must be on a domain verified in
    // Resend — not sensitive, so it lives here rather than as a secret.
    "RESEND_FROM_EMAIL": "DEEC Studio <customers@deecstudio-quotingtools.online>",
    // Whop has a separate plan per language for the same $149.99
    // product — functions/lib/current-terms-version.js picks between
    // these two based on the language the buyer is checking out in
    // (checkout.html's <html lang>, sent as `lang` in the create request).
    // These are the sole source of truth for what checkout.html actually
    // charges, so the price/plan can't be tampered with from the client.
    "WHOP_PLAN_ID_ES": "plan_arIZ7TA4dFciG",
    "WHOP_PLAN_ID_EN": "plan_I1QRqcdWTnKPf"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
