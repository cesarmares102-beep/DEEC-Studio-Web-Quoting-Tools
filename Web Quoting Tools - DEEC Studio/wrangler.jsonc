{
  "name": "deec-studio-web-quoting-tools",
  "compatibility_date": "2026-09-21",
  "main": "dist_worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "WHOP_PURCHASES", "id": "ab4f4e764ea24b91979a9e223c1f4e5f" }
  ],
  "vars": {
    "META_DATASET_ID": "1068830012634174"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
