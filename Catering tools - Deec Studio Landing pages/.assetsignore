# Cloudflare Workers static assets ignore dotfiles/dot-folders by default
# (.git, etc). .well-known must stay included — it's required for the
# Apple Pay merchant domain-association file.
!.well-known
!.well-known/**

# functions/ is the Pages-Functions source that gets compiled into
# dist_worker/ by the build command — neither should be servable as raw
# static files (no secrets in them, but no reason to expose server-side
# source/build output either). wrangler.jsonc only holds a KV namespace
# id (not secret) but same principle applies.
functions/
dist_worker/
wrangler.jsonc

# Local dev helper — not part of the site.
tools/
